# Copy to .env (repo root or backend/) and adjust. Every setting has a safe development default.

ENVIRONMENT=development                 # development | test | production
POSTGRES_PORT=5432                      # host port for docker compose

DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
CHECKPOINT_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm   # psycopg 3, for LangGraph

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=false                     # true behind HTTPS
CORS_ORIGINS=["http://localhost:5173"]

# LLM: mock (default, no API calls) | anthropic | openai_compatible (vLLM, Ollama, LM Studio...)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=                           # for openai_compatible, e.g. http://localhost:8001/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_CURRENCY=BHD
UBO_THRESHOLD_PCT=25

# Early-warning rule thresholds
EWS_BALANCE_DROP_PCT=25
EWS_UTILIZATION_PCT=90
EWS_UTILIZATION_DAYS=30
EWS_DOC_EXPIRY_DAYS=30

SEED_PASSWORD=demo1234                  # demo users; development only
